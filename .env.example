DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=twm_hrms
DATABASE_USER=twm_hrms_app
DATABASE_PASSWORD=

# Set to true only for local UI work when MariaDB is not running.
USE_MEMORY_STORE=false

# HOST/PORT: leave both as-is for local dev. On Hostinger's Node.js app
# manager (and most similar hosts), the platform injects its own PORT at
# startup — don't set PORT here in production; the app now reads real
# platform env vars ahead of this file once NODE_ENV=production (see env.js).
HOST=127.0.0.1
PORT=4000
# Production: the site's own https://yourdomain.com — the built frontend is
# served from the same origin as the API (see app.js), so this mainly
# matters for the CORS allow-list.
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# Hostinger Business mailbox. Confirm exact host/port in hPanel > Emails >
# Mailboxes > Connect apps & devices — plans vary between 465/SSL and
# 587/STARTTLS. SMTP_USER must be a full mailbox address on your domain
# (Hostinger requires this); leave SMTP_FROM blank to default to SMTP_USER.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=
SMTP_FROM=

# Minutes a password-reset link stays valid.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
