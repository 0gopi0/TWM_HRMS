{
  "name": "twm-hrms",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:api": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=frontend",
    "db:migrate": "npm run migrate --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "esbuild@0.25.12": true
  }
}
